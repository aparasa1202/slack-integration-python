    {
      "botId": "0874b1a0-7e8c-44cb-a0f1-6dc29636322a",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "tror.ai",
    "token.botframework.com"
  ],
  "webApplicationInfo": {
    "id": "0874b1a0-7e8c-44cb-a0f1-6dc29636322a",
    "resource": "https://RscBasedStoreApp"
  }
