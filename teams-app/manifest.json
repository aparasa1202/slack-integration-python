  "description": {
    "short": "Chat directly with your AI Agent in Microsoft Teams",
    "full": "This bot allows users to interact with your AI agent built on your custom platform. It provides conversational capabilities, responds to queries, and integrates with your backend services. Use !agent for custom agent queries and !gpt for ChatGPT integration."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#60A18E",
