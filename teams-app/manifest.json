    "name": "Abhinay Parasa",
    "websiteUrl": "https://tror.ai",
    "privacyUrl": "https://tror.ai/privacy",
    "termsOfUseUrl": "https://tror.ai/terms"
  },
  "name": {
    "short": "Tror Bot",
    "full": "Tror Conversational AI Agent"
